# ============================================================
#              VENOM MD — Environment Variables
# ============================================================

# ─── REQUIRED ────────────────────────────────────────────────────────────────

# Your VENOM_... session string (get it from the pairing page)
SESSION_ID=

# Your WhatsApp number — country code + number, NO + or spaces
# Example: 2348021016309
# If left blank, defaults to the super-owner (2348021016309)
OWNER_NUMBER=2348021016309

# ─── OPTIONAL API KEYS ───────────────────────────────────────────────────────

# OpenAI — enables .ai .gpt and .imagine commands
OPENAI_API_KEY=

# OpenWeatherMap (free at openweathermap.org) — enables .weather command
WEATHER_API_KEY=

# ─── OPTIONAL BEHAVIOR ───────────────────────────────────────────────────────

# public  = anyone can use the bot in groups AND DMs
# private = only you (OWNER_NUMBER) can use commands
# self    = alias for private (only owner)
# group   = bot only responds in groups (DM users need whitelist)
BOT_MODE=public

# Automatically mark messages as read
AUTO_READ=false

# Reject all incoming calls
ANTI_CALL=false

# ─── SERVER ──────────────────────────────────────────────────────────────────
PORT=3000

# ─── LOGGING ─────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
