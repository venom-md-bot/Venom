# ─────────────────────────────────────────────────────────────────────────────
# Venom MD — Environment Variables
# Copy this file to .env for local dev, or add these in Render → Environment.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED after pairing ────────────────────────────────────────────────────
SESSION_ID=           # Full VENOM_eyJ... string from the /pair page
OWNER_NUMBER=         # Your WhatsApp number, no + or spaces (e.g. 2348021016309)

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
BOT_NAME=Venom MD     # Display name shown in menus and startup message
PREFIX=.              # Command prefix character (default: dot)
BOT_MODE=public       # public | private | group
AUTO_READ=false       # Auto-read messages (true/false)
ANTI_CALL=false       # Reject incoming calls (true/false)

# ── AI / Media API keys (leave blank to disable those commands) ───────────────
OPENAI_API_KEY=
WEATHER_API_KEY=
GENIUS_API_KEY=
